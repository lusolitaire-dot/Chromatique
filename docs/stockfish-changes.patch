+std::array<float,N> features_fast(const Position& pos){
+    std::array<float,N> x{};Color us=pos.side_to_move();
+    int own=int(pos.square<KING>(us))^(us==WHITE?0:56),enemy=int(pos.square<KING>(~us))^(us==WHITE?0:56);
